# BrightCore Careers environment configuration.
# Copy this file to `.env` and adjust the values. Never commit `.env`.

# --- Database ---------------------------------------------------------------
# Used by the app, migrations and the seed script when running outside Docker.
# The default points at the Compose PostgreSQL container, published on port 5433.
# (Inside Docker Compose the app connects to the `db` service automatically.)
DATABASE_URL="postgresql://brightcore:replace-with-a-local-db-password@localhost:5433/brightcore?schema=public"

# Separate database used ONLY by the automated tests. Its tables are emptied
# between tests, so never point this at a database you care about.
# The database name must contain "test".
TEST_DATABASE_URL="postgresql://brightcore:replace-with-a-local-db-password@localhost:5433/brightcore_test?schema=public"

# Credentials for the Docker Compose PostgreSQL container (local use only).
# If the password contains URL-reserved characters, URL-encode it in the URLs above.
POSTGRES_USER="brightcore"
POSTGRES_PASSWORD="replace-with-a-local-db-password"
POSTGRES_DB="brightcore"

# --- Seeded administrator (development only) ---------------------------------
# The seed script creates (or updates) this administrator and hashes the
# password with Argon2id. Use at least 12 characters.
ADMIN_EMAIL="admin@brightcore.test"
ADMIN_PASSWORD="replace-with-a-local-admin-password"

# --- Application -------------------------------------------------------------
# Business timezone for closing dates. A job accepts applications until the end
# of its closing date in this timezone.
APP_TIMEZONE="Africa/Kigali"

# Private CV storage directory. Must be outside `public/`; it is never served
# directly. Relative paths resolve from the project root.
CV_STORAGE_DIR="./storage/cvs"

# The session cookie is marked Secure whenever NODE_ENV=production. Set this to
# "false" only to run a production build over plain HTTP on localhost.
# SESSION_COOKIE_SECURE="false"
